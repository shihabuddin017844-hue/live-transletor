{
  "manifest_version": 3,
  "name": "Word Saver",
  "version": "1.1",
  "description": "Highlight a word to see its Bengali meaning and save it to Google Sheets.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}